# Шаблон переменных окружения. Скопируй в `.env` и заполни значения.
# `.env` — в .gitignore; этот файл (`.env.example`) — коммитится.

# === LLM: OpenAI-совместимый шлюз (решения D-02 / D-13) ===
# Dev/tests — локальная Ollama ($0):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:14b
# Прод — прямой DeepSeek API (раскомментируй и укажи ключ; ID модели — из кабинета):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_MODEL_PRO=deepseek-reasoner   # резерв для сложных фаз (M2+)
# Альтернатива — DeepSeek через OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=

# === Поиск (решение F-01) ===
# RU: Яндекс Search API v2 — рублёвая карта, тестовый объём ~10K запросов/мес.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# EN: Tavily free tier (опционально; EN-сбор в основном через RSS/fetch_url без ключей).
TAVILY_API_KEY=

# === On-chain (бесплатно по умолчанию) ===
# DefiLlama — без ключа. CoinGecko — бесплатный tier без ключа, ключ только для повышения лимитов.
COINGECKO_API_KEY=

# === Whale / платные on-chain (опционально, подключаются на M3+) ===
WHALE_ALERT_API_KEY=
NANSEN_API_KEY=
SANTIMENT_API_KEY=
GLASSNODE_API_KEY=

# === Приложение ===
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_PATH=data/crypto_trends.db
# Эмбеддер: на M0 — заглушка; на M1+ — локальный bge-m3 (грузится лениво).
EMBEDDER_MODEL=BAAI/bge-m3

# === Пороги верификации (калибровка по eval, решение D-27) ===
ANTI_REPEAT_THRESHOLD=0.85
PUMP_PRICE_CHANGE_7D=30.0
CONFIRMATION_CHANGE=10.0

# Бюджет фазы research (сек): после него оставшиеся кандидаты идут без исследования.
RESEARCH_BUDGET_SECONDS=600
